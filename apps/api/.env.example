# Copie para .env e ajuste. O .env nunca é versionado (ADR 0012).
NODE_ENV=development
PORT=3333
# Origem do front permitida no CORS
WEB_ORIGIN=http://localhost:5173
# Postgres local do docker-compose.yml (na raiz). Em produção: string do Neon.
DATABASE_URL=postgresql://financas:financas@localhost:5434/financas
# Segredo que assina os cookies de sessão (mínimo 32 caracteres). Vazio de propósito: a API
# não sobe sem ele. Gere um por ambiente com:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública desta API (o Better Auth monta links de callback e de e-mail a partir dela)
BETTER_AUTH_URL=http://localhost:3333
