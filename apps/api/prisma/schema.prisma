// Data dictionary of the app (ADR 0005). Conventions:
// - models in PascalCase, tables and columns in snake_case (@@map / @map);
// - ids are UUIDv7 (time-ordered, not guessable) — ADR 0017;
// - money in integer cents, dates per ADR 0010;
// - every business table has workspace_id (ADR 0008).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Owner of all financial data (ADR 0008). The personal workspace is created with the user, is
// never shared nor deleted, and there is exactly one per user (ADR 0024).
model Workspace {
  id               String                 @id @default(uuid(7)) @db.Uuid
  name             String                 @db.VarChar(100)
  isPersonal       Boolean                @default(false) @map("is_personal")
  members          Member[]
  invitations      Invitation[]
  categories       Category[]
  transactions     Transaction[]
  budgetConfigs    BudgetConfig[]
  recurrences      Recurrence[]
  installmentPlans InstallmentPlan[]
  imports          TransactionImport[]
  occurrences      RecurrenceOccurrence[]
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER

  @@map("workspace_role")
}

// Who can access a workspace, and with which role (ADR 0008).
model Member {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("members")
}

// ---------------------------------------------------------------------------
// Authentication (ADRs 0007 and 0020). Shape required by Better Auth's core schema; Better Auth
// reads and writes these through the Prisma adapter using the model and field names, so the
// snake_case mapping below is invisible to it. Ids come from Prisma (generateId: false).
// ---------------------------------------------------------------------------

model User {
  id              String              @id @default(uuid(7)) @db.Uuid
  name            String              @db.VarChar(100)
  email           String              @unique @db.VarChar(254)
  emailVerified   Boolean             @default(false) @map("email_verified")
  image           String?
  /// The terms of use version last accepted, and when (ADR 0041). Null: never accepted.
  termsVersion    String?             @map("terms_version") @db.VarChar(20)
  termsAcceptedAt DateTime?           @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  memberships     Member[]
  invitationsSent Invitation[]
  importsCreated  TransactionImport[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

// One row per login method of a user: "credential" (e-mail and password hash) or an OAuth provider.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

// Short-lived tokens: e-mail verification, password reset.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Rate limit counters of the auth routes, one row per client IP + route (ADR 0023). Stored in the
// database so they survive API restarts. A technical table owned by Better Auth: no
// created_at/updated_at, last_request (epoch milliseconds, as Better Auth writes it) plays that role.
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// Invitation to join a workspace, sent by e-mail (ADR 0027). Only a hash of the token is stored:
// a leaked database does not expose working links. Pending = not accepted and not expired.
model Invitation {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String        @db.VarChar(254)
  role        WorkspaceRole
  tokenHash   String        @unique @map("token_hash")
  invitedById String?       @map("invited_by_id") @db.Uuid
  invitedBy   User?         @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?     @map("accepted_at") @db.Timestamptz(3)
  // When the membership it gave ended: the OWNER removed the person, or they left on their own.
  // The accepted invitation stays as the record of how they came in and went out.
  removedAt   DateTime?     @map("removed_at") @db.Timestamptz(3)
  leftOnOwn   Boolean       @default(false) @map("left_on_own")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workspaceId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Business tables (phase 3). Each one has workspace_id and the Row Level Security policy of
// ADR 0028, added by hand to its migration (Prisma does not manage policies). The API reads and
// writes them through PrismaService.forWorkspace().
// ---------------------------------------------------------------------------

// Money in (CREDIT) or out (DEBIT): the type of categories and, later, of transactions.
enum TransactionType {
  CREDIT
  DEBIT

  @@map("transaction_type")
}

// Classifies transactions, per type. New workspaces get the default ones; a category in use is
// archived, not deleted (docs/dominio/modelo.md).
model Category {
  id               String            @id @default(uuid(7)) @db.Uuid
  workspaceId      String            @map("workspace_id") @db.Uuid
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String            @db.VarChar(50)
  type             TransactionType
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactions     Transaction[]
  recurrences      Recurrence[]
  installmentPlans InstallmentPlan[]

  @@unique([workspaceId, type, name])
  // Target of the composite foreign key of transactions (ADR 0029).
  @@unique([id, workspaceId, type])
  @@map("categories")
}

// Lançamento: a credit or debit of one competência (ADR 0010). The category is referenced with
// (category_id, workspace_id, type), so the database itself refuses a category of another
// workspace or of the other type, and the deletion of a category in use (ADR 0029). NoAction
// (checked at the end of the statement) instead of Restrict lets a workspace be deleted with
// its categories and transactions in one go. CHECKs on amount and period are in the migration.
model Transaction {
  id                String                @id @default(uuid(7)) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type              TransactionType
  description       String                @db.VarChar(200)
  notes             String?               @db.VarChar(1000)
  categoryId        String                @map("category_id") @db.Uuid
  category          Category              @relation(fields: [categoryId, workspaceId, type], references: [id, workspaceId, type], onDelete: NoAction, onUpdate: NoAction)
  amountCents       Int                   @map("amount_cents")
  period            String                @db.Char(7)
  dueDate           DateTime?             @map("due_date") @db.Date
  settledAt         DateTime?             @map("settled_at") @db.Date
  // Generated by a variable recurrence and not yet confirmed: the amount is an estimate (ADR 0038).
  amountEstimated   Boolean               @default(false) @map("amount_estimated")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  occurrence        RecurrenceOccurrence?
  // Parcela: which plan and which of its installments (ADR 0038). Both or neither (CHECK in the
  // migration); the description stays the purchase's, the "3/10" comes from these.
  installmentPlanId String?               @map("installment_plan_id") @db.Uuid
  installmentPlan   InstallmentPlan?      @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  installmentNumber Int?                  @map("installment_number") @db.SmallInt
  // Brought in by a spreadsheet import (ADR 0040): undoing the import deletes it.
  importId          String?               @map("import_id") @db.Uuid
  importBatch       TransactionImport?    @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([installmentPlanId, installmentNumber])
  @@index([workspaceId, period])
  @@index([categoryId])
  @@index([importId])
  @@map("transactions")
}

// Importação (ADR 0040): one spreadsheet import, all its transactions created at once and
// undone together (deleting it cascades to them). The file never reaches the API: the browser
// reads it and sends only the confirmed transactions. CHECKs on count and periods are in the
// migration.
model TransactionImport {
  id               String        @id @default(uuid(7)) @db.Uuid
  workspaceId      String        @map("workspace_id") @db.Uuid
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Who imported; kept as null if that account is later deleted.
  createdById      String?       @map("created_by") @db.Uuid
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transactionCount Int           @map("transaction_count")
  firstPeriod      String        @map("first_period") @db.Char(7)
  lastPeriod       String        @map("last_period") @db.Char(7)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  transactions     Transaction[]

  @@index([workspaceId, createdAt])
  @@map("imports")
}

// Parcelamento (ADR 0038): a purchase or debt split into monthly installments. Unlike a
// recurrence it has an end, so all its transactions are created with it, one per competência
// from first_period on; the cents a split leaves go to the last one. Ending it removes the
// pending installments from this month on and stamps ended_at. Same composite category key as
// transactions; CHECKs on amount, count and periods are in the migration.
model InstallmentPlan {
  id           String          @id @default(uuid(7)) @db.Uuid
  workspaceId  String          @map("workspace_id") @db.Uuid
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type         TransactionType
  description  String          @db.VarChar(200)
  notes        String?         @db.VarChar(1000)
  categoryId   String          @map("category_id") @db.Uuid
  category     Category        @relation(fields: [categoryId, workspaceId, type], references: [id, workspaceId, type], onDelete: NoAction, onUpdate: NoAction)
  totalCents   Int             @map("total_cents")
  installments Int             @db.SmallInt
  firstPeriod  String          @map("first_period") @db.Char(7)
  dueDay       Int?            @map("due_day") @db.SmallInt
  endedAt      DateTime?       @map("ended_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactions Transaction[]

  @@index([workspaceId])
  @@map("installment_plans")
}

// Recorrência (ADR 0038): a transaction that repeats every month (energy, internet, the card
// bill). It is not a transaction itself: opening a competência creates its pending transaction
// there, with the estimated amount. Active while end_period is null. Same composite category key
// as transactions. CHECKs on amount, due day and periods are in the migration.
model Recurrence {
  id             String                 @id @default(uuid(7)) @db.Uuid
  workspaceId    String                 @map("workspace_id") @db.Uuid
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type           TransactionType
  description    String                 @db.VarChar(200)
  notes          String?                @db.VarChar(1000)
  categoryId     String                 @map("category_id") @db.Uuid
  category       Category               @relation(fields: [categoryId, workspaceId, type], references: [id, workspaceId, type], onDelete: NoAction, onUpdate: NoAction)
  amountCents    Int                    @map("amount_cents")
  // Energy, water: each month starts from the average of the last 3 settled (ADR 0038).
  variableAmount Boolean                @default(false) @map("variable_amount")
  // Day of the month it is due (1-31); a longer number than the month has means its last day.
  dueDay         Int?                   @map("due_day") @db.SmallInt
  startPeriod    String                 @map("start_period") @db.Char(7)
  endPeriod      String?                @map("end_period") @db.Char(7)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  occurrences    RecurrenceOccurrence[]

  @@index([workspaceId])
  @@map("recurrences")
}

// One competência a recurrence was generated for (ADR 0038). Created together with its
// transaction in one nested write, and unique per (recurrence, period), so opening a month twice
// at once never duplicates it. Deleting the transaction keeps the occurrence with no transaction:
// that month is not generated again.
model RecurrenceOccurrence {
  recurrenceId  String       @map("recurrence_id") @db.Uuid
  recurrence    Recurrence   @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  period        String       @db.Char(7)
  workspaceId   String       @map("workspace_id") @db.Uuid
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactionId String?      @unique @map("transaction_id") @db.Uuid
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@id([recurrenceId, period])
  @@index([workspaceId, period])
  @@map("recurrence_occurrences")
}

// Budget of one competência: income and the share of it for each destination, in basis points
// (ADR 0010). Only competências someone saved have a row; the others inherit the latest earlier
// one (ADR 0030). The CHECKs (ranges, sum <= 100%) are in the migration.
model BudgetConfig {
  id                 String    @id @default(uuid(7)) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  period             String    @db.Char(7)
  netIncomeCents     Int       @map("net_income_cents")
  grossIncomeCents   Int?      @map("gross_income_cents")
  expensesBp         Int       @map("expenses_bp")
  investmentsBp      Int       @map("investments_bp")
  emergencyReserveBp Int       @map("emergency_reserve_bp")
  travelBp           Int       @map("travel_bp")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([workspaceId, period])
  @@map("budget_configs")
}
