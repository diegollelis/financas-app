# Copie para .env e ajuste. O .env nunca é versionado (ADR 0012).
NODE_ENV=development
PORT=3333
# Origem do front permitida no CORS
WEB_ORIGIN=http://localhost:5173
# Postgres local do docker-compose.yml (na raiz). Em produção: string do Neon.
DATABASE_URL=postgresql://financas:financas@localhost:5434/financas
# Segredo que assina os cookies de sessão (mínimo 32 caracteres). Vazio de propósito: a API
# não sobe sem ele. Gere um por ambiente com:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública desta API (o Better Auth monta links de callback e de e-mail a partir dela)
BETTER_AUTH_URL=http://localhost:3333
# E-mail (ADR 0022). Em desenvolvimento os e-mails vão para o Mailpit do docker-compose:
# abra http://localhost:8025 para ver a caixa de entrada. Em produção: MAIL_TRANSPORT=resend.
MAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025
# Só com MAIL_TRANSPORT=resend. A chave fica apenas no .env / no painel do Render, nunca no git.
RESEND_API_KEY=
# Sem domínio próprio, o Resend só envia a partir deste endereço de teste
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_FROM_NAME=Finanças
# Login com Google (ADR 0026). Opcional: sem as duas, só e-mail e senha. Crie em
# https://console.cloud.google.com/apis/credentials (ID do cliente OAuth, tipo "Aplicativo da Web")
# com o URI de redirecionamento http://localhost:3333/api/auth/callback/google. Nunca versione.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
