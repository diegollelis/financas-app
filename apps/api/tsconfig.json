{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": true,
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src", "test"]
}
