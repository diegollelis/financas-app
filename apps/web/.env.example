# Copie para .env.local. Variáveis com prefixo VITE_ vão para o navegador: nunca coloque segredos aqui.
VITE_API_URL=http://localhost:3333
# Relatório de erros (ADR 0034). Vazio em desenvolvimento; em produção, a DSN do projeto do front
# no Sentry. A DSN é pública por natureza (vai no JavaScript do site): ela só permite enviar eventos.
VITE_SENTRY_DSN=
# Endereço oficial do app (ADR 0039). Vazio em desenvolvimento; em produção, a URL do domínio
# próprio: quem abrir o app em outro endereço (o *.pages.dev antigo) é levado para ela.
VITE_CANONICAL_ORIGIN=
