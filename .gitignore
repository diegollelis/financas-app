# Dependências e build
node_modules/
dist/
build/
.turbo/
coverage/
# Capturas de tela da revisão de interface (apps/web/scripts/screenshots.ts): vão nos PRs, não no git
.screenshots/
*.tsbuildinfo
# Client do Prisma: gerado a partir do schema (pnpm db:generate)
**/src/generated/

# Variáveis de ambiente (nunca versionar segredos)
.env
.env.*
!.env.example

# Dados pessoais / financeiros — nunca versionar (o repositório é público, ADR 0019)
*.xlsx
*.xls
*.xlsm
*.ods
*.csv
*.ofx
*.qif
*.dump
*.backup
*.sqlite
*.db
backups/
dumps/
# Fixtures de teste com dados fictícios podem ser liberadas por exceção, ex.: !**/fixtures/*.csv

# Chaves e certificados
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
# (não ignorar *.sql: as migrações do Prisma são migration.sql)

# Logs e SO
*.log
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
