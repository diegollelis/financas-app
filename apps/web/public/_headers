# Security headers of the site (Cloudflare Pages, ADR 0041 note of 2026-10-10). They apply to the
# static files, the pages included; /api/* answers come from the API through the Function.
# - CSP: only this site's own scripts, styles, fonts and images; the API is on the same site
#   (/api), and the browser reports errors to Sentry's ingest (ADR 0034). Inline styles stay
#   allowed: the dialogs and toasts set them at run time.
# - frame-ancestors / X-Frame-Options: no other site can show the app inside a frame
#   (clickjacking).
# - HSTS: after the first visit, the browser never tries plain http again (1 year).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io; manifest-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
